# Modelo do .env. Para criar o seu com segredos aleatórios:  python scripts/gerar_env.py
# O .env fica só na sua máquina (está no .gitignore). Nunca commite chaves, senhas ou tokens.

AIRFLOW_VERSION=3.3.2
AIRFLOW_UID=50000
AIRFLOW_PORT=8080

POSTGRES_PASSWORD=troque-me
FERNET_KEY=troque-me
AIRFLOW_JWT_SECRET=troque-me

# Usuário e senha da interface web do Airflow
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=troque-me

# Variables do Airflow definidas pelo ambiente: AIRFLOW_VAR_<NOME>. Todas são opcionais.
# Chaves de API e webhooks entram aqui (ou em Admin > Variables), nunca no código.
# Atenção: uma variável de ambiente, mesmo vazia, vence a de Admin > Variables. Só descomente o que for usar.
#
# Aviso de falha/sucesso da coleta (Discord ou Slack). Sem ela, o aviso fica só no log.
# AIRFLOW_VAR_WEBHOOK_NOTIFICACAO_SECRET=https://discord.com/api/webhooks/...
# Outros, com valor padrão no código:
# AIRFLOW_VAR_INCLUI_PLACES_URL=https://raw.githubusercontent.com/kaikyalvaro1708/inclui-gs/main/site/assets/js/data/places.js
# AIRFLOW_VAR_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
# AIRFLOW_VAR_OSM_REAPROVEITAR_HORAS=12
# AIRFLOW_VAR_TAXA_SUJEIRA_RELATOS=0.06
